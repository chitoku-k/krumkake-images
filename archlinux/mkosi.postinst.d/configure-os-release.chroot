#!/usr/bin/env bash

set -euo pipefail
cd /tmp

source /usr/lib/os-release

while read -r line; do
    case $line in
        PRETTY_NAME=*)
            echo "PRETTY_NAME=\"$PRETTY_NAME ($IMAGE_VERSION)\""
            ;;

        *)
            echo "$line"
            ;;
    esac
done < /usr/lib/os-release > /usr/lib/os-release.new

mv /usr/lib/os-release{.new,}
